[sub_resource type="Shader" id="GroundShader"]
code = "shader_type spatial;\nrender_mode diffuse_burley, specular_schlick_ggx;\n\nfloat terrain_hash(vec2 p) {\n    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\nfloat terrain_noise(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = terrain_hash(i);\n    float b = terrain_hash(i + vec2(1.0, 0.0));\n    float c = terrain_hash(i + vec2(0.0, 1.0));\n    float d = terrain_hash(i + vec2(1.0, 1.0));\n    return mix(mix(a, b, f.x), mix(c, d, f.x), mix(c, d, f.x));\n}\n\nvoid fragment() {\n    float fine = terrain_noise(UV * 58.0);\n    float broad = terrain_noise(UV * 12.0 + vec2(4.3, 8.1));\n    float patches = terrain_noise(UV * 25.0 + vec2(12.0, 2.0));\n    vec3 dark_grass = vec3(0.10, 0.25, 0.085);\n    vec3 fresh_grass = vec3(0.26, 0.48, 0.18);\n    vec3 dry_grass = vec3(0.42, 0.39, 0.20);\n    vec3 soil = vec3(0.30, 0.22, 0.13);\n    vec3 color = mix(dark_grass, fresh_grass, fine);\n    color = mix(color, dry_grass, smoothstep(0.66, 0.92, broad) * 0.34);\n    color = mix(color, soil, smoothstep(0.84, 0.98, patches) * 0.22);\n    ALBEDO = color;\n    ROUGHNESS = 0.97;\n}\n"

