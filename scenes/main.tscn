[sub_resource type="Shader" id="GroundShader"]
code = "shader_type spatial;\nrender_mode diffuse_burley, specular_schlick_ggx;\n\nvarying vec3 terrain_world_pos;\n\nfloat terrain_hash(vec2 p) {\n    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\nfloat terrain_noise(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = terrain_hash(i);\n    float b = terrain_hash(i + vec2(1.0, 0.0));\n    float c = terrain_hash(i + vec2(0.0, 1.0));\n    float d = terrain_hash(i + vec2(1.0, 1.0));\n    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\nvoid vertex() {\n    float h1 = terrain_noise(VERTEX.xz * 0.065);\n    float h2 = terrain_noise(VERTEX.xz * 0.16 + vec2(4.0, 9.0));\n    VERTEX.y += (h1 - 0.5) * 0.16 + (h2 - 0.5) * 0.055;\n    terrain_world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;\n}\n\nvoid fragment() {\n    vec2 p = terrain_world_pos.xz;\n    float micro = terrain_noise(p * 1.9);\n    float small = terrain_noise(p * 0.58 + vec2(2.1, 7.8));\n    float medium = terrain_noise(p * 0.19 + vec2(12.0, 3.0));\n    float macro = terrain_noise(p * 0.055 + vec2(27.0, 18.0));\n\n    vec3 deep = vec3(0.095, 0.205, 0.065);\n    vec3 mid = vec3(0.18, 0.355, 0.105);\n    vec3 fresh = vec3(0.27, 0.47, 0.145);\n    vec3 dry = vec3(0.36, 0.33, 0.15);\n    vec3 earth = vec3(0.30, 0.215, 0.12);\n\n    vec3 color = mix(deep, mid, small);\n    color = mix(color, fresh, medium * 0.42);\n    color = mix(color, dry, smoothstep(0.72, 0.94, macro) * 0.26);\n    color = mix(color, earth, smoothstep(0.84, 0.98, small) * 0.12);\n    color += (micro - 0.5) * 0.055;\n\n    ALBEDO = color;\n    ROUGHNESS = 0.98;\n}\n"

